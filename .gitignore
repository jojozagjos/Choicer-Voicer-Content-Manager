# Dependencies
node_modules/

# Build output. The app folder is ~400 MB and the zip ~167 MB, so neither
# belongs in git; they go on a GitHub release instead.
dist/
*.exe

# assets/ is deliberately NOT ignored. The app draws its own icon and the
# character placeholder from there at runtime, and the .ico is a build input.

# Claude Code. settings.local.json is this machine's permission list, so it
# stays local; a shared .claude/settings.json would be fine to commit.
.claude/settings.local.json

# Logs and caches
*.log
.cache/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Exported videos, in case the app is ever pointed at the repo folder
exports/
*.mp4
*.mkv
*.mov
*.webm
*.srt
